# Local/open-weight inference. No paid inference-provider API is used.
PROVIDER_ORDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
PIPELINE_CONCURRENCY=1
MAX_TOKENS=4096
DEBUG=false

# Required for stable sessions in production. Generate a unique value with:
# openssl rand -hex 48
JWT_SECRET=replace_in_production
